FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
# Where the demo Parquet lives after ./scripts/unzip-data.sh. Defaults to the
# repo's data/ dir; uncomment to override.
# XGRAPH_DATA_DIR=/abs/path/to/data
KINETICA_URL=http://127.0.0.1:9191
KINETICA_USER=admin
KINETICA_PASS=
# Optional LLM overrides (default backend is the `claude` CLI on PATH):
# XGRAPH_LLM_MODEL=claude-opus-4-7            # ask/explain model (default: CLI default)
# XGRAPH_EXTRACT_MODEL=claude-haiku-4-5-20251001  # extraction + fold-checks (default: Haiku, fast)
# XGRAPH_LLM_TIMEOUT=180

# ── LLM route (Mechanism × Auth) ─────────────────────────────────────────────
# The gateway loads this file at startup so the LLM route works regardless of
# the shell it was launched from. Precedence: UI override > env (below) > default.
#
# Claude via GCP Vertex (recommended default). Vertex auth uses server-side GCP
# ADC — run `gcloud auth application-default login` on the gateway host.
# CLAUDE_CODE_USE_VERTEX=1
# ANTHROPIC_VERTEX_PROJECT_ID=team-warehouse-workhorses-dev
# CLOUD_ML_REGION=global
# ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-8
#
# Alternative: direct Anthropic API key (leave the Vertex vars unset if using).
# ANTHROPIC_API_KEY=sk-ant-...
